@"
# Frontend dependencies and build output
client/node_modules/
client/dist/

# Python virtual environments and caches
server/.venv/
server/__pycache__/
server/**/*.pyc
.pytest_cache/

# Environment files and local databases
.env
.env.*
!.env.example
*.db
*.sqlite
*.sqlite3

# Editor and operating-system files
.vscode/
.DS_Store
Thumbs.db
"@ | Set-Content -Encoding utf8 .gitignore

# Python test and coverage output
.pytest_cache/
.coverage
coverage.xml
test-results.xml
htmlcov/